# ============================================================================
# ATELIER 3D — Environment Configuration
# Copy to .env.local and fill in real values. Never commit real credentials.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only. Used for admin operations, storage admin and triggers.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Public app -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (adapter in src/lib/payments) ---------------------------------
# Provider: "test" (sandbox, no real charges) | "stripe" | "custom".
PAYMENT_PROVIDER=test
# Required when PAYMENT_PROVIDER=stripe
PAYMENT_PROVIDER_SECRET_KEY=sk_test_...
PAYMENT_PUBLISHABLE_KEY=pk_test_...
# Shared secret used to verify webhook signatures (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=whsec_...
# Base URL the payment provider should call back into.
PAYMENT_WEBHOOK_URL=

# --- Email (adapter in src/lib/email) --------------------------------------
# "console" (logs only) | "resend" | "smtp"
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_...
EMAIL_FROM_NAME=ATELIER 3D
EMAIL_FROM_ADDRESS=hello@atelier3d.example
# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Storage ----------------------------------------------------------------
# Public storage bucket names (created in migrations/seed).
NEXT_PUBLIC_STORAGE_BUCKET=public
# Max upload size for 3D models in bytes (default 25 MB)
MODEL_UPLOAD_MAX_BYTES=26214400
